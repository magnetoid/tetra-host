[Unit]
Description=Tetra Host Console (Next.js)
After=network.target tetra-host.service
Wants=tetra-host.service

[Service]
Type=simple
User=tetrahost
Group=tetrahost
WorkingDirectory=/opt/tetra-host/apps/web
Environment=NODE_ENV=production
Environment=PORT=8099
Environment=HOSTNAME=127.0.0.1
Environment=BACKEND_API_BASE_URL=http://127.0.0.1:8088/api/v1
# Node 22: a private copy in /opt/tetra-host/.node when the system node is older.
Environment=PATH=/opt/tetra-host/.node/bin:/usr/local/bin:/usr/bin:/bin
# Which build slot to serve (TETRA_NEXT_DIST_DIR), written by scripts/deploy.sh.
EnvironmentFile=-/opt/tetra-host/data/console.env
ExecStart=/usr/bin/env node /opt/tetra-host/apps/web/node_modules/next/dist/bin/next start -H 127.0.0.1 -p 8099
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ReadWritePaths=-/opt/tetra-host/apps/web/.next -/opt/tetra-host/apps/web/.next-a -/opt/tetra-host/apps/web/.next-b

[Install]
WantedBy=multi-user.target
